# =============================================================================
# .dockerignore
# Controls what is sent to the Docker build daemon as the build context.
# Keeping this tight reduces build time, image size, and attack surface.
# =============================================================================

# ---------- Version control ----------
.git
.gitignore

# ---------- Dependencies ----------
# node_modules is installed inside the container via npm ci; never copy the
# host version — it may contain platform-specific binaries.
node_modules

# ---------- Build output ----------
# The builder stage compiles TypeScript; pre-existing dist/ on the host must
# not shadow what the builder produces.
dist
build

# ---------- Environment & secrets ----------
# .env files must NEVER be baked into the image. They are mounted at runtime
# by Docker Compose or injected by the hosting platform.
.env
.env.*
*.env

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE & editor ----------
.vscode
.idea
*.swp
*.swo
*.suo
.DS_Store
Thumbs.db

# ---------- Test & coverage ----------
coverage
.nyc_output

# ---------- Linting & formatting config ----------
# Not needed at runtime.
.eslintrc*
eslint.config.*
.prettierrc*
.prettierignore

# ---------- CI / deployment ----------
.github
.gitlab-ci.yml
.circleci
Jenkinsfile
.vercel
.netlify

# ---------- Docker files themselves ----------
# The Compose file and this file are not needed inside the image.
docker-compose*.yml
.dockerignore

# ---------- Documentation ----------
README.md
CHANGELOG.md
*.md

# ---------- Misc ----------
*.tgz
*.zip
tmp/
temp/
