generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String?
  fullName     String
  profileImage String?
  authProvider AuthProvider @default(LOCAL)
  role         UserRole     @default(USER)
  status       UserStatus   @default(ACTIVE)
  isVerified   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  otps          OTP[]
  refreshTokens RefreshToken[]

  @@index([role, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

model OTP {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  type      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, isUsed, expiresAt])
  @@index([expiresAt])
  @@index([isUsed, createdAt])
  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
}