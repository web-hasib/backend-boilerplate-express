generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  fullName     String
  profileImage String?
  role         UserRole @default(USER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  otps          OTP[]
  refreshTokens RefreshToken[]

  @@index([role, isDeleted, isActive])
  @@map("users")
}

model OTP {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  type      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, isUsed, expiresAt])
  @@index([expiresAt])
  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}